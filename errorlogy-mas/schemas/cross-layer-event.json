{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/errorlogy/ai-native-gov/schemas/cross-layer-event.json",
  "title": "CrossLayerEvent",
  "description": "Event envelope with institutional layer activation (vendored copy; prefer AI_NATIVE_GOV_SCHEMAS env)",
  "type": "object",
  "required": ["story_id", "event_type", "activated_layers", "epistemic_label"],
  "properties": {
    "story_id": {
      "type": "string",
      "description": "Stable story anchor (politic.bar stream ID)",
      "examples": ["2026-08-summit-trump-macron"]
    },
    "event_type": {
      "type": "string",
      "examples": [
        "bilateral_summit",
        "sanctions_coordination",
        "domestic_policy",
        "fin_crypto_market_snapshot",
        "fin_crypto_technical_indicator",
        "fin_crypto_screener_rank_update",
        "fin_crypto_news_headline",
        "fin_crypto_sentiment_momentum",
        "fin_crypto_onchain_risk",
        "fin_crypto_backtest_result",
        "fin_crypto_walk_forward_validation",
        "fin_crypto_data_unavailable",
        "gov_open_data_snapshot",
        "gov_legislative_document",
        "gov_parliamentary_activity",
        "gov_data_unavailable",
        "symbolic_media_discovered",
        "symbolic_media_fetched",
        "symbolic_provenance_incomplete",
        "symbolic_rights_blocked",
        "symbolic_asset_registered",
        "symbolic_nft_mint_signal",
        "symbolic_media_variant",
        "symbolic_lore_source_linked"
      ]
    },
    "activated_layers": {
      "type": "array",
      "items": { "$ref": "institution-layer-id.json" },
      "minItems": 1
    },
    "topology_intersections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intersection", "tension_type"],
        "properties": {
          "intersection": {
            "type": "string",
            "examples": ["executive-judiciary", "parliament-executive"]
          },
          "tension_type": { "type": "string" },
          "resolution_status": {
            "type": "string",
            "enum": ["unresolved", "partially_resolved", "resolved", "not_applicable"]
          }
        }
      }
    },
    "jurisdiction_set": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ISO 3166-1 alpha-2 or institutional slugs"
    },
    "coordination_forum": {
      "type": "string",
      "examples": ["NATO", "EU Council", "bilateral", "UN SC"]
    },
    "politifi_assets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "politic.bar asset slugs (brand:*, agenda:*, institution:*)"
    },
    "stream_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "precedent_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Prior error card IDs for α graph"
    },
    "certificate_ref": {
      "type": "string",
      "description": "Optional NAMM certificate.json URI"
    },
    "epistemic_label": {
      "type": "string",
      "enum": [
        "INSTITUTIONAL_MODEL",
        "OPERATIONAL",
        "COMPUTATIONAL_EVIDENCE",
        "PHILOSOPHICAL_INFERENCE"
      ]
    }
  },
  "additionalProperties": false
}
