ANTHROPIC_API_KEY=sk-ant-...

# Exa web search / ingest (optional — graceful disable if unset)
EXA_API_KEY=exa-...
# EXA_SEARCH_TYPE=auto          # auto|fast|deep|deep-reasoning (default: auto)
# EXA_PREFERRED=true            # prefer Exa over OpenRouter/Gemini for web search + discovery
# EXA_AGENT_MODE=true           # use Exa Agent API instead of /search (usage-based)
# EXA_AGENT_EFFORT=minimal      # minimal|low|medium|high|xhigh|auto

# US gov ingest (optional — Federal Register + CourtListener work without keys)
GOVINFO_API_KEY=
COURTLISTENER_API_TOKEN=
LEGISCAN_API_KEY=
